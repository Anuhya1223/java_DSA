import java.util.Scanner;
class Banks{
	int balance=0;
	void checkbalance() {
		System.out.println(balance);
	}
	void deposite(int a) {
		balance=balance+a;
	}
	void withdraw(int a) {
		balance=balance-a;
	}
}
public class bank {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
