//two pointer problem
public class add2numbers {
	public static void main(String[] args) {
		// TODO Auto-generated method stub
		int arr[] = {1, 2, 4, 5, 7, 10};
		int target = 9;
		int left=0;
		int right=arr.length-1;
		while(left<right) {
			int sum=arr[left]+arr[right];
			if(sum==target) {
				System.out.println("pair is found");
				break;
			}
			else if(sum<target) {
				left++;
			}
			else if(sum>target) {
				right--;
			}
			
		}
		 
}
}
